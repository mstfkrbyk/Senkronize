{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Senkronize",
  "version": "0.1.0",
  "identifier": "com.senkronize.desktop",
  "build": {
    "beforeDevCommand": "pnpm exec concurrently -k \"vite --port 1420 --strictPort\" \"pnpm --filter panel dev\"",
    "beforeBuildCommand": "pnpm run vite:embed-build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Senkronize",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
