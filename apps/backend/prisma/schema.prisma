  PRODUCTS
  LISTINGS
  STOCK
  PROFIT
  PLATFORM_COMPARISON
  CUSTOM
}

enum StandardReportKind {
  SALES
  STOCK
  PROFIT
}

enum ReportScheduleFrequency {
  WEEKLY
  MONTHLY
}

enum StockMovementType {
  SALE // satış
  RETURN // iade
  PURCHASE // satın alma / tedarik
  ADJUSTMENT // manuel düzeltme
  TRANSFER // depo transferi
  RESERVATION // rezervasyon oluşturma
  RESERVATION_RELEASE // rezervasyon serbest bırakma
  SYNC // platform senkronizasyonu
}

enum StockCountSessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StockCountMode {
  FULL
  PARTIAL
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum POStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum NotificationType {
  ORDER_NEW
  ORDER_STATUS_CHANGED
  STOCK_LOW
  STOCK_OUT
  SYNC_SUCCESS
  SYNC_ERROR
  PRICE_UPDATED
  BUYBOX_WON
  BUYBOX_LOST
  SUBSCRIPTION_EXPIRING
  PAYMENT_FAILED
  SYSTEM
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique // refresh token hash
  ipAddress    String?
  userAgent    String?
  deviceInfo   String?
  location     String?
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model UserInvite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           UserRole
  invitedBy      String
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("UserInvitesSent", fields: [invitedBy], references: [id], onDelete: Restrict)

  @@unique([organizationId, email, acceptedAt])
  @@index([organizationId, email])
}

model Organization {
  id                        String    @id @default(cuid())
  slug                      String    @unique
  name                      String
  taxNumber                 String?   @unique
  taxOffice                 String?
  address                   String?
  city                      String?
  website                   String?
  referralCode              String?
  suspended                 Boolean   @default(false)
  onboardingCompleted       Boolean   @default(false)
  type                      OrgType
  logoUrl                   String?
  /// Panel ve raporlarda varsayılan para birimi (ISO 4217)
  defaultCurrency           String    @default("TRY")
  /// true ise `currencyManualRates` değerleri TCMB kurlarına göre önceliklidir
  currencyPreferManualRates Boolean   @default(false)
  /// TCMB dışı sabit kurlar: { "USD": 34.5, "EUR": 37.2 } — 1 birim = X TRY
  currencyManualRates       Json?
  /// Organizasyon için TCMB otomatik kurlarını kullan (false = yalnızca manuel)
  currencyTcmbEnabled       Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  deletedAt                 DateTime?

  users                     User[]
  subscription              Subscription?
  marketplaceConnections    MarketplaceConnection[]
  erpConnections            ErpConnection[]
  ecommerceConnections      EcommerceConnection[]
  cargoConnections          CargoConnection[]
  products                  Product[]
  productVariants           ProductVariant[]
  listings                  Listing[]
  stockEntries              StockEntry[]
  warehouses                Warehouse[]
  stockMovements            StockMovement[]
  stockCountSessions        StockCountSession[]
  stockCountItems           StockCountItem[]
  stockTransfers            StockTransfer[]
  orders                    Order[]
  reservations              Reservation[]
  partnerRelationships      PartnerRelationship[]     @relation("PartnerOrg")
  clientRelationships       PartnerRelationship[]     @relation("ClientOrg")
  commissionLedgerAsPartner CommissionLedger[]        @relation("LedgerPartnerOrg")
  commissionLedgerAsClient  CommissionLedger[]        @relation("LedgerClientOrg")
  whiteLabelSettings        WhiteLabelSettings?
  partnerClientOnboardings  ClientOnboarding[]        @relation("PartnerOnboarding")
  clientOnboardingsAsClient ClientOnboarding[]        @relation("ClientOnboardingClient")
  paytrSubscription         PaytrSubscription?
  iyzicoSubscription        IyzicoSubscription?
  payments                  Payment[]
  pricingRules              PricingRule[]
  competitorPrices          CompetitorPrice[]
  priceHistories            PriceHistory[]
  buyBoxSnapshots           BuyBoxSnapshot[]
  webhookEvents             WebhookEvent[]
  webhookLogs               WebhookLog[]
  notificationPreferences   NotificationPreference[]
  notificationDigestItems   NotificationDigestItem[]
  inAppNotifications        InAppNotification[]
  apiKeys                   ApiKey[]
  userInvites               UserInvite[]
  savedReports              SavedReport[]
  reportSchedules           ReportSchedule[]
  suppliers                 Supplier[]
  purchaseOrders            PurchaseOrder[]
  returns                   Return[]
  productCategories         ProductCategory[]
  platformCategoryMappings  PlatformCategoryMapping[]
  productMatches            ProductMatch[]
  webhookEndpoints          WebhookEndpoint[]
  syncConflicts             SyncConflict[]
  supportTickets            SupportTicket[]
  campaigns                 Campaign[]
  priceAlerts               PriceAlert[]
  customers                 Customer[]
  partnerProfile            PartnerProfile?
  clientLinkRequests        PartnerLinkRequest[]      @relation("ClientLinkRequests")
  partnerLinkRequests       PartnerLinkRequest[]      @relation("PartnerLinkRequests")
}

/// TCMB ve manuel sistem döviz kurları (kiracıdan bağımsız)
model ExchangeRate {
  id             String   @id @default(cuid())
  baseCurrency   String
  targetCurrency String
  rate           Decimal  @db.Decimal(18, 6)
  source         String   @default("TCMB")
  fetchedAt      DateTime @default(now())

  @@unique([baseCurrency, targetCurrency, fetchedAt])
  @@index([baseCurrency, targetCurrency])
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  keyHash        String       @unique
  keyPrefix      String
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([keyPrefix])
}

model WebhookEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform       Marketplace
  eventType      String // "ORDER_STATUS_CHANGED", "PRODUCT_APPROVED" vb.
  payload        Json
  processed      Boolean      @default(false)
  processedAt    DateTime?
  error          String?
  receivedAt     DateTime     @default(now())

  @@index([organizationId, processed])
  @@index([organizationId, platform])
}

/// Gelen pazaryeri webhook kaydı (imza sonrası); idempotency için payloadHash benzersizdir.
model WebhookLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  platform       String
  eventType      String
  payload        Json
  payloadHash    String
  status         String // received | processed | failed | skipped
  errorMessage   String?
  processedAt    DateTime?
  createdAt      DateTime      @default(now())

  @@unique([platform, payloadHash])
  @@index([platform, createdAt])
  @@index([organizationId, createdAt])
}

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

/// Giden (outbound) müşteri webhook uç noktası
model WebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  url            String
  secret         String
  events         String[]
  isActive       Boolean  @default(true)
  retryCount     Int      @default(3)
  timeoutMs      Int      @default(5000)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
}

model WebhookDelivery {
  id           String         @id @default(cuid())
  endpointId   String
  event        String
  payload      Json
  statusCode   Int?
  responseBody String?
  duration     Int?
  attempt      Int            @default(1)
  status       DeliveryStatus
  createdAt    DateTime       @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, status])
  @@index([createdAt])
}

model User {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String        @unique
  passwordHash   String
  name           String
  phone          String?
  role           UserRole
  permissions    Json          @default("{}")
  lastLoginAt    DateTime?
  /// Başarısız giriş eşiği sonrası geçici kilit (UTC)
  lockedUntil    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String? // AES-256-GCM ile şifreli TOTP secret
  backupCodes      String[] @default([]) // bcrypt ile hashlenmiş yedek kodlar

  refreshTokens RefreshToken[]
  sessions      UserSession[]
  sentInvites   UserInvite[]   @relation("UserInvitesSent")

  notificationPreference    NotificationPreference?
  notificationDigestItems   NotificationDigestItem[]
  pushSubscriptions         PushSubscription[]
  inAppNotifications        InAppNotification[]
  savedReports              SavedReport[]
  reportSchedules           ReportSchedule[]
  stockCountSessionsStarted StockCountSession[]      @relation("StockCountSessionCreatedBy")
  supportTickets            SupportTicket[]
  ticketMessages            TicketMessage[]
}

model InAppNotification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  type           NotificationType
  title          String
  message        String
  link           String?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  metadata       Json?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, isRead, createdAt])
  @@index([userId, isRead])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailEnabled      Boolean @default(true)
  emailNewOrder     Boolean @default(true)
  emailLowStock     Boolean @default(true)
  emailStockOut     Boolean @default(false)
  emailSyncError    Boolean @default(true)
  emailWeeklyReport Boolean @default(true)
  emailTicketReply  Boolean @default(true)
  emailPlanExpiry   Boolean @default(true)

  pushEnabled   Boolean @default(false)
  pushNewOrder  Boolean @default(true)
  pushLowStock  Boolean @default(false)
  pushSyncError Boolean @default(true)

  inAppEnabled      Boolean @default(true)
  inAppSoundEnabled Boolean @default(false)

  digestFrequency String @default("daily")
  digestHour      Int    @default(9)

  newOrder     Boolean @default(true)
  stockAlert   Boolean @default(true)
  paymentAlert Boolean @default(true)
  syncError    Boolean @default(true)
  smsEnabled   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationDigestItem {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  eventType      String
  title          String
  message        String
  link           String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([organizationId])
}

model Subscription {
  id                  String         @id @default(cuid())
  organizationId      String         @unique
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                PlanTier
  status              SubStatus
  billingPeriod       BillingPeriod?
  trialEndsAt         DateTime?
  nextBillingAt       DateTime?
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  subscriptionEndsAt  DateTime?
  paytrSubscriptionId String?
  monthlyOrderLimit   Int?
  marketplaceLimit    Int?
  ecommerceLimit      Int?
  erpLimit            Int?
  userLimit           Int?
  addons              Json           @default("[]")
  canceledAt          DateTime?
  cancelReason        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model IyzicoSubscription {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerRefCode       String?
  subscriptionRefCode   String?      @unique
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

/// Iyzico abonelik ürün/plan referansları (plan + dönem)
model IyzicoPricingPlan {
  id                   String        @id @default(cuid())
  plan                 PlanTier
  billingPeriod        BillingPeriod
  productRefCode       String
  pricingPlanRefCode   String        @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([plan, billingPeriod])
}

model PaytrSubscription {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paytrSubsId     String?      @unique
  paytrCustomerId String?
  cardToken       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Payment {
  id                     String         @id @default(cuid())
  organizationId         String
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amount                 Int
  currency               String         @default("TRY")
  status                 PaymentStatus
  plan                   PlanTier
  billingPeriod          BillingPeriod?
  paytrOrderId           String?        @unique
  paytrPaymentId         String?
  iyzicoConversationId   String?        @unique
  iyzicoCheckoutToken    String?
  iyzicoOrderReference   String?        @unique
  periodStart            DateTime?
  periodEnd              DateTime?
  failReason             String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([organizationId])
}

model MarketplaceConnection {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform         Marketplace
  credentialsEnc   String // AES-256-GCM ile şifrelenmiş JSON
  isActive         Boolean      @default(true)
  lastSyncAt       DateTime?
  syncErrorCount   Int          @default(0)
  lastErrorAt      DateTime?
  lastErrorMessage String?
  /// Son başarılı sync özet meta (ör. işlenen sipariş/listing sayısı)
  lastSyncMeta     Json?
  webhookSecret    String? // platform'dan gelen webhook doğrulaması için
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  @@unique([organizationId, platform])
  @@index([organizationId])
}

model ErpConnection {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  erpType          ErpType
  credentialsEnc   String // AES-256-GCM ile şifrelenmiş JSON
  isActive         Boolean      @default(true)
  lastSyncAt       DateTime?
  syncErrorCount   Int          @default(0)
  lastErrorAt      DateTime?
  lastErrorMessage String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  @@unique([organizationId, erpType])
  @@index([organizationId])
}

model EcommerceConnection {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform       EcommerceType
  credentialsEnc String
  isActive       Boolean       @default(true)
  lastSyncAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, platform])
}

model CargoConnection {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       CargoProvider
  credentialsEnc String?
  isActive       Boolean       @default(true)
  lastSyncAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, provider])
}

/// Hiyerarşik iç ürün kategorisi (tenant bazlı)
model ProductCategory {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  slug           String
  parentId       String?
  level          Int       @default(0)
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent           ProductCategory?          @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children         ProductCategory[]         @relation("CategoryHierarchy")
  products         Product[]
  platformMappings PlatformCategoryMapping[]

  @@unique([organizationId, slug])
  @@index([organizationId, parentId])
}

/// İç kategori ↔ pazaryeri kategori eşlemesi
model PlatformCategoryMapping {
  id                   String      @id @default(cuid())
  organizationId       String
  internalCategoryId   String
  platform             Marketplace
  platformCategoryId   String
  platformCategoryName String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  internalCategory ProductCategory @relation(fields: [internalCategoryId], references: [id], onDelete: Cascade)

  @@unique([organizationId, internalCategoryId, platform])
  @@index([organizationId, platform])
}

/// Merkezi ürün ↔ pazaryeri listeleme barkodu eşlemesi
model ProductMatch {
  id              String      @id @default(cuid())
  organizationId  String
  masterProductId String
  platformBarcode String
  platform        Marketplace
  platformSku     String?
  confidence      Float       @default(1)
  isConfirmed     Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  masterProduct Product      @relation("ProductMasterMatches", fields: [masterProductId], references: [id], onDelete: Restrict)

  @@unique([organizationId, platformBarcode, platform])
  @@index([organizationId, masterProductId])
}

// Merkezi ürün kataloğu (ERP veya manuel)
model Product {
  id                   String           @id @default(cuid())
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  barcode              String
  sku                  String?
  name                 String
  description          String?
  brand                String?
  category             String?
  categoryId           String?
  costPrice            Decimal?         @db.Decimal(12, 2)
  reorderPoint         Int? // min stok seviyesi
  reorderQty           Int? // sipariş miktarı
  leadTimeDays         Int? // tedarik süresi (gün)
  tags                 String[]         @default([])
  imageUrls            String[]
  isActive             Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?
  productCategory      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants             ProductVariant[]
  listings             Listing[]
  stockEntries         StockEntry[]
  reservations         Reservation[]
  stockCountItems      StockCountItem[]
  stockTransferItems   StockTransferItem[]
  masterProductMatches ProductMatch[]   @relation("ProductMasterMatches")

  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, categoryId])
}

model ProductVariant {
  id             String    @id @default(cuid())
  organizationId String
  productId      String
  sku            String
  barcode        String?
  title          String
  attributes     Json
  price          Decimal?  @db.Decimal(12, 2)
  costPrice      Decimal?  @db.Decimal(12, 2)
  stock          Int       @default(0)
  imageUrl       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sku])
  @@index([productId])
  @@index([organizationId, isActive])
}

// Pazaryerindeki ürün listesi (platform x ürün)
model Listing {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  platform          Marketplace
  platformProductId String
  barcode           String
  title             String
  salePrice         Decimal        @db.Decimal(10, 2)
  listPrice         Decimal        @db.Decimal(10, 2)
  quantity          Int            @default(0)
  approved          Boolean        @default(false)
  isActive          Boolean        @default(true)
  imageUrls         String[]
  lastSyncAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  priceHistories    PriceHistory[]
  priceAlerts       PriceAlert[]

  @@unique([organizationId, platform, platformProductId])
  @@index([organizationId])
  @@index([organizationId, platform])
  @@index([barcode, organizationId])
}

// Stok takibi (platform bazlı veya merkezi)
model StockEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  barcode        String
  platform       Marketplace? // null = merkezi stok
  quantity       Int
  reservedQty    Int          @default(0)
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  @@unique([organizationId, barcode, platform, warehouseId])
  @@index([organizationId])
  @@index([warehouseId])
}

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  name           String // "Ana Depo", "İkinci Depo", "3PL Deposu"
  code           String // "MAIN", "WH2", "3PL"
  address        String?
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockEntries       StockEntry[]
  movements          StockMovement[]
  stockCountSessions StockCountSession[]
  transfersFrom      StockTransfer[]     @relation("TransferFrom")
  transfersTo        StockTransfer[]     @relation("TransferTo")

  @@unique([organizationId, code])
  @@index([organizationId])
}

model StockTransfer {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromWarehouseId String
  toWarehouseId   String
  fromWarehouse   Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  status          TransferStatus      @default(DRAFT)
  note            String?
  createdBy       String
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  items           StockTransferItem[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Int

  @@index([transferId])
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  barcode        String
  warehouseId    String?
  platform       String? // hangi pazaryeri
  movementType   StockMovementType
  quantity       Int // + veya -
  beforeQuantity Int
  afterQuantity  Int
  orderId        String? // bağlı sipariş
  note           String?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([organizationId, barcode, createdAt])
  @@index([organizationId, movementType, createdAt])
}

model StockCountSession {
  id             String                  @id @default(cuid())
  organizationId String
  warehouseId    String
  status         StockCountSessionStatus @default(IN_PROGRESS)
  countMode      StockCountMode
  filterBrand    String?
  filterCategory String?
  startedAt      DateTime                @default(now())
  completedAt    DateTime?
  createdBy      String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  creator      User             @relation("StockCountSessionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  items        StockCountItem[]

  @@index([organizationId, status])
}

model StockCountItem {
  id              String   @id @default(cuid())
  organizationId  String
  sessionId       String
  barcode         String
  productId       String?
  productName     String?
  platformLabel   String?
  systemQuantity  Int
  countedQuantity Int
  difference      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product      Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([sessionId, barcode])
  @@index([sessionId])
  @@index([organizationId])
}

model Order {
  id                      String       @id @default(cuid())
  organizationId          String
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform                Marketplace
  platformOrderId         String
  status                  OrderStatus
  customerName            String
  customerPhone           String?
  shippingAddress         String?
  totalAmount             Decimal      @db.Decimal(10, 2)
  currency                String       @default("TRY")
  cargoTrackingNumber     String?
  cargoProvider           String?
  platformCreatedAt       DateTime
  syncedAt                DateTime     @default(now())
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  deletedAt               DateTime?
  cancellationRequestedAt DateTime?
  cancellationRequestNote String?
  items                   OrderItem[]
  returns                 Return[]

  @@unique([organizationId, platform, platformOrderId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, platform])
  @@index([organizationId, createdAt])
  @@index([platformOrderId, organizationId])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organizationId String
  sku            String
  barcode        String
  productName    String?
  quantity       Int
  unitPrice      Decimal  @db.Decimal(10, 2)
  platformItemId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId])
  @@index([organizationId])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalId     String?
  platform       Marketplace?
  name           String
  email          String?
  phone          String?
  city           String?
  country        String       @default("TR")
  totalOrders    Int          @default(0)
  totalSpent     Decimal      @default(0) @db.Decimal(14, 2)
  firstOrderAt   DateTime?
  lastOrderAt    DateTime?
  tags           String[]
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, platform, externalId])
  @@index([organizationId])
  @@index([organizationId, email])
}

model Return {
  id               String       @id @default(cuid())
  organizationId   String
  orderId          String
  platform         Marketplace
  platformReturnId String?      @unique
  status           ReturnStatus
  reason           String?
  items            ReturnItem[]
  refundAmount     Decimal?     @db.Decimal(12, 2)
  refundStatus     String?
  requestedAt      DateTime
  resolvedAt       DateTime?
  notes            String?
  statusLog        Json?
  stockRestoredAt  DateTime?
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([orderId])
}

model ReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  barcode   String
  quantity  Int
  reason    String?
  condition String?

  return Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

model Reservation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity       Int
  sourceOrderId  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PartnerProfile {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  commissionRate Decimal      @default(10.00) @db.Decimal(5, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PartnerLinkRequest {
  id           String            @id @default(cuid())
  clientOrgId  String
  partnerOrgId String
  status       PartnerLinkStatus @default(PENDING)
  message      String?
  adminNote    String?
  requestedAt  DateTime          @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?

  clientOrg  Organization @relation("ClientLinkRequests", fields: [clientOrgId], references: [id], onDelete: Cascade)
  partnerOrg Organization @relation("PartnerLinkRequests", fields: [partnerOrgId], references: [id], onDelete: Cascade)

  @@unique([clientOrgId, partnerOrgId])
  @@index([status])
}

model PartnerRelationship {
  id              String        @id @default(cuid())
  partnerOrgId    String
  partnerOrg      Organization  @relation("PartnerOrg", fields: [partnerOrgId], references: [id], onDelete: Cascade)
  clientOrgId     String?
  clientOrg       Organization? @relation("ClientOrg", fields: [clientOrgId], references: [id], onDelete: Cascade)
  invitedEmail    String?
  status          PartnerStatus @default(PENDING)
  commissionPct   Decimal       @default(10) @db.Decimal(5, 2)
  canImpersonate  Boolean       @default(true)
  inviteToken     String?       @unique
  inviteExpiresAt DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([partnerOrgId, clientOrgId])
  @@index([partnerOrgId])
  @@index([clientOrgId])
  @@index([partnerOrgId, invitedEmail])
}

model CommissionLedger {
  id           String         @id @default(cuid())
  partnerOrgId String
  partnerOrg   Organization   @relation("LedgerPartnerOrg", fields: [partnerOrgId], references: [id], onDelete: Cascade)
  clientOrgId  String
  clientOrg    Organization   @relation("LedgerClientOrg", fields: [clientOrgId], references: [id], onDelete: Cascade)
  type         CommissionType
  amount       Decimal        @db.Decimal(10, 2)
  currency     String         @default("TRY")
  description  String?
  referenceId  String?
  status       LedgerStatus   @default(PENDING)
  createdAt    DateTime       @default(now())
  settledAt    DateTime?

  @@index([partnerOrgId])
  @@index([clientOrgId])
}

model WhiteLabelSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  brandName      String?
  logoUrl        String?
  primaryColor   String?
  supportEmail   String?
  supportPhone   String?
  customDomain   String?
  hideSenkronize Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ClientOnboarding {
  id              String    @id @default(cuid())
  organizationId  String
  clientOrgId     String?
  status          String    @default("INVITED")
  inviteEmail     String
  inviteToken     String    @unique
  inviteExpiresAt DateTime
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  organization Organization  @relation("PartnerOnboarding", fields: [organizationId], references: [id], onDelete: Cascade)
  clientOrg    Organization? @relation("ClientOnboardingClient", fields: [clientOrgId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}

model AuditLog {
  id                String   @id @default(cuid())
  actorUserId       String
  actorOrgId        String
  impersonatedOrgId String?
  action            String
  resourceType      String
  resourceId        String?
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Fiyatlandırma kuralları (Pro+)
model PricingRule {
  id                   String          @id @default(cuid())
  organizationId       String
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  platform             Marketplace
  strategy             PricingStrategy
  minMarginPct         Decimal         @default(10) @db.Decimal(5, 2)
  maxDiscountPct       Decimal         @default(20) @db.Decimal(5, 2)
  targetPosition       Int             @default(1)
  /// Maliyet fiyatı (kâr hesaplama için, TRY)
  costPrice            Float?
  /// Minimum kâr marjı oranı (0.10 = %10); yoksa minMarginPct kullanılır
  minMarginPercent     Float?
  /// Rakip / BuyBox fiyatından düşülecek adım (TRY)
  stepAmount           Float?
  /// Gece (00–06) indirim oranı (0.05 = %5)
  nightDiscountPercent Float?
  /// Öğle peak premium (0.03 = %3)
  peakPremiumPercent   Float?
  /// Düşük stok eşiği (adet)
  lowStockThreshold    Int?
  /// Yüksek stok eşiği (adet)
  highStockThreshold   Int?
  /// Tavan fiyat (TRY)
  maxPrice             Float?
  isActive             Boolean         @default(true)
  applyToAll           Boolean         @default(false)
  barcodes             String[]
  /// Zamanlanmış başlangıç (anlık)
  scheduledStart       DateTime?
  /// Zamanlanmış bitiş (anlık)
  scheduledEnd         DateTime?
  /// Haftanın günleri (0=Pazar … 6=Cumartesi); boş = tüm günler
  daysOfWeek           Int[]           @default([])
  /// Başlangıç saati İstanbul (0–23); boş = saat kısıtı yok
  hoursStart           Int?
  /// Bitiş saati İstanbul (0–23)
  hoursEnd             Int?
  /// Ürün kategorisi filtre metni (içerir eşleşmesi)
  categoryFilter       String?
  /// Marka filtre metni (içerir eşleşmesi)
  brandFilter          String?
  /// SKU / barkod regex deseni
  skuPattern           String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?
  priceHistories       PriceHistory[]

  @@index([organizationId])
  @@index([organizationId, platform])
}

/// Pazaryerinden çekilen rakip satıcı fiyatları
model CompetitorPrice {
  id             String      @id @default(cuid())
  organizationId String
  barcode        String
  platform       Marketplace
  competitorId   String
  competitorName String?
  price          Decimal     @db.Decimal(12, 2)
  currency       String      @default("TRY")
  isBuyBox       Boolean     @default(false)
  capturedAt     DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, barcode, platform, capturedAt])
}

// Fiyat değişim geçmişi
model PriceHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listingId      String?
  listing        Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  barcode        String
  platform       Marketplace
  pricingRuleId  String?
  pricingRule    PricingRule? @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)
  oldPrice       Decimal      @db.Decimal(12, 2)
  newPrice       Decimal      @db.Decimal(12, 2)
  /// manual | rule | campaign | sync
  source         String       @default("manual")
  reason         String?
  appliedAt      DateTime     @default(now())

  @@index([organizationId, barcode])
  @@index([organizationId, platform])
  @@index([listingId, appliedAt])
}

/// Fiyat eşiği uyarısı — fiyat belirlenen seviyenin altına düşünce bildirim
model PriceAlert {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listingId      String
  listing        Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  thresholdPrice Decimal      @db.Decimal(12, 2)
  notifyEmail    Boolean      @default(true)
  notifyInApp    Boolean      @default(true)
  notifySms      Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, listingId])
}

// BuyBox anlık veri (rakip fiyat takibi)
model BuyBoxSnapshot {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  barcode         String
  platform        Marketplace
  buyBoxPrice     Decimal      @db.Decimal(10, 2)
  ourPrice        Decimal      @db.Decimal(10, 2)
  isWinner        Boolean      @default(false)
  competitorCount Int          @default(0)
  capturedAt      DateTime     @default(now())

  @@index([organizationId, barcode, platform])
  @@index([organizationId, platform, capturedAt])
}

model SavedReport {
  id             String     @id @default(cuid())
  organizationId String
  name           String
  description    String?
  reportType     ReportType
  config         Json
  schedule       Json?
  lastRunAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdBy      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [createdBy], references: [id], onDelete: Restrict)

