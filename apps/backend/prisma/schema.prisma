// Senkronize — multi-tenant veri modeli (Bölüm 7 + tamamlayıcı ilişkiler)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgType {
  DIRECT
  PARTNER
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  MANAGER
  VIEWER
}

enum PlanTier {
  BASLANGIC
  GELISIM
  PRO
  KURUMSAL
}

enum SubStatus {
  TRIAL
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum Marketplace {
  TRENDYOL
  HEPSIBURADA
  N11
  AMAZON_TR
  CICEKSEPETI
  IDEASOFT
  PTTAVM
  PAZARAMA
  TSOFT
  TICIMAX
  WOOCOMMERCE
  SHOPIFY
  GETIR
  GRATIS
  BOYNER
  MORHIPO
  DOLAP
  EBAY
  ETSY
  TEMU
  SAHIBINDEN
  MIGROS
  HEPSIEXPRESS
  FLO
  DEFACTO
  LCWAIKIKI
  VATAN
  MEDIAMARKT
  TEKNOSA
  KOTON
  MAVI
}

enum PricingStrategy {
  MATCH_BUYBOX
  BEAT_BUYBOX
  FIXED_MARGIN
  DYNAMIC
  AGGRESSIVE_BUYBOX
  PROFIT_FOCUSED
  TIME_BASED
  STOCK_BASED
}

enum ErpType {
  BIZIMHESAP
  PARASUT
  TSOFT
  TICIMAX
  LOGO
  MIKRO
  LUCA
  NETSIS
  ETA
  KOLAYBI
  ZIRVE
  NEBIM
  EBA
  SAP_B1
  ISNET
}

enum EcommerceType {
  TICIMAX
  TSOFT
}

enum CargoProvider {
  YURTICI
  ARAS
  MNG
  SURAT
  PTT
  UPS
  DHL
  HEPSIJET
  TRENDYOL_EXPRESS
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum CommissionType {
  SUBSCRIPTION_FEE
  SERVICE_FEE
  BONUS
  DEDUCTION
}

enum LedgerStatus {
  PENDING
  SETTLED
  CANCELLED
}

enum SyncDirection {
  PUSH
  PULL
}

enum OrderStatus {
  NEW
  PICKING
  INVOICED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model Organization {
  id                  String    @id @default(cuid())
  slug                String    @unique
  name                String
  taxNumber           String?   @unique
  taxOffice           String?
  address             String?
  city                String?
  website             String?
  referralCode        String?
  suspended           Boolean   @default(false)
  onboardingCompleted Boolean   @default(false)
  type                OrgType
  logoUrl             String?
  createdAt           DateTime  @default(now())
  deletedAt           DateTime?

  users                     User[]
  subscription              Subscription?
  marketplaceConnections    MarketplaceConnection[]
  erpConnections            ErpConnection[]
  ecommerceConnections      EcommerceConnection[]
  cargoConnections          CargoConnection[]
  products                  Product[]
  listings                  Listing[]
  stockEntries              StockEntry[]
  orders                    Order[]
  reservations              Reservation[]
  partnerRelationships      PartnerRelationship[]    @relation("PartnerOrg")
  clientRelationships       PartnerRelationship[]    @relation("ClientOrg")
  commissionLedgerAsPartner CommissionLedger[]       @relation("LedgerPartnerOrg")
  commissionLedgerAsClient  CommissionLedger[]       @relation("LedgerClientOrg")
  paytrSubscription         PaytrSubscription?
  payments                  Payment[]
  pricingRules              PricingRule[]
  priceHistories            PriceHistory[]
  buyBoxSnapshots           BuyBoxSnapshot[]
  webhookEvents             WebhookEvent[]
  notificationPreferences   NotificationPreference[]
  apiKeys                   ApiKey[]
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  keyHash        String       @unique
  keyPrefix      String
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([keyPrefix])
}

model WebhookEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform       Marketplace
  eventType      String // "ORDER_STATUS_CHANGED", "PRODUCT_APPROVED" vb.
  payload        Json
  processed      Boolean      @default(false)
  processedAt    DateTime?
  error          String?
  receivedAt     DateTime     @default(now())

  @@index([organizationId, processed])
  @@index([organizationId, platform])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  passwordHash   String
  name           String
  phone          String?
  role           UserRole
  permissions    Json         @default("{}")
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  refreshTokens RefreshToken[]

  notificationPreference NotificationPreference?
  pushSubscriptions      PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  newOrder       Boolean      @default(true)
  stockAlert     Boolean      @default(true)
  paymentAlert   Boolean      @default(true)
  syncError      Boolean      @default(true)
  emailEnabled   Boolean      @default(true)
  smsEnabled     Boolean      @default(false)
  pushEnabled    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Subscription {
  id                  String       @id @default(cuid())
  organizationId      String       @unique
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                PlanTier
  status              SubStatus
  trialEndsAt         DateTime?
  nextBillingAt       DateTime?
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  paytrSubscriptionId String?
  monthlyOrderLimit   Int?
  marketplaceLimit    Int?
  ecommerceLimit      Int?
  erpLimit            Int?
  userLimit           Int?
  addons              Json         @default("[]")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model PaytrSubscription {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paytrSubsId     String?      @unique
  paytrCustomerId String?
  cardToken       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amount         Int
  currency       String        @default("TRY")
  status         PaymentStatus
  paytrOrderId   String        @unique
  paytrPaymentId String?
  plan           PlanTier
  periodStart    DateTime?
  periodEnd      DateTime?
  failReason     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
}

model MarketplaceConnection {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform         Marketplace
  credentialsEnc   String // AES-256-GCM ile şifrelenmiş JSON
  isActive         Boolean      @default(true)
  lastSyncAt       DateTime?
  syncErrorCount   Int          @default(0)
  lastErrorAt      DateTime?
  lastErrorMessage String?
  /// Son başarılı sync özet meta (ör. işlenen sipariş/listing sayısı)
  lastSyncMeta     Json?
  webhookSecret    String? // platform'dan gelen webhook doğrulaması için
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  @@unique([organizationId, platform])
  @@index([organizationId])
}

model ErpConnection {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  erpType          ErpType
  credentialsEnc   String // AES-256-GCM ile şifrelenmiş JSON
  isActive         Boolean      @default(true)
  lastSyncAt       DateTime?
  syncErrorCount   Int          @default(0)
  lastErrorAt      DateTime?
  lastErrorMessage String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  @@unique([organizationId, erpType])
  @@index([organizationId])
}

model EcommerceConnection {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform       EcommerceType
  credentialsEnc String
  isActive       Boolean       @default(true)
  lastSyncAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, platform])
}

model CargoConnection {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       CargoProvider
  credentialsEnc String?
  isActive       Boolean       @default(true)
  lastSyncAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([organizationId, provider])
}

// Merkezi ürün kataloğu (ERP veya manuel)
model Product {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  barcode        String
  sku            String?
  name           String
  description    String?
  brand          String?
  category       String?
  imageUrls      String[]
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  listings       Listing[]
  stockEntries   StockEntry[]
  reservations   Reservation[]

  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([organizationId, createdAt])
}

// Pazaryerindeki ürün listesi (platform x ürün)
model Listing {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  platform          Marketplace
  platformProductId String
  barcode           String
  title             String
  salePrice         Decimal      @db.Decimal(10, 2)
  listPrice         Decimal      @db.Decimal(10, 2)
  quantity          Int          @default(0)
  approved          Boolean      @default(false)
  imageUrls         String[]
  lastSyncAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  @@unique([organizationId, platform, platformProductId])
  @@index([organizationId])
  @@index([organizationId, platform])
  @@index([barcode, organizationId])
}

// Stok takibi (platform bazlı veya merkezi)
model StockEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  barcode        String
  platform       Marketplace? // null = merkezi stok
  quantity       Int
  reservedQty    Int          @default(0)
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  @@unique([organizationId, barcode, platform])
  @@index([organizationId])
}

model Order {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform            Marketplace
  platformOrderId     String
  status              OrderStatus
  customerName        String
  customerPhone       String?
  shippingAddress     String?
  totalAmount         Decimal      @db.Decimal(10, 2)
  currency            String       @default("TRY")
  cargoTrackingNumber String?
  cargoProvider       String?
  platformCreatedAt   DateTime
  syncedAt            DateTime     @default(now())
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?
  items               OrderItem[]

  @@unique([organizationId, platform, platformOrderId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, platform])
  @@index([organizationId, createdAt])
  @@index([platformOrderId, organizationId])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  organizationId String
  sku            String
  barcode        String
  productName    String?
  quantity       Int
  unitPrice      Decimal  @db.Decimal(10, 2)
  platformItemId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId])
  @@index([organizationId])
}

model Reservation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity       Int
  sourceOrderId  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PartnerRelationship {
  id              String        @id @default(cuid())
  partnerOrgId    String
  partnerOrg      Organization  @relation("PartnerOrg", fields: [partnerOrgId], references: [id], onDelete: Cascade)
  clientOrgId     String?
  clientOrg       Organization? @relation("ClientOrg", fields: [clientOrgId], references: [id], onDelete: Cascade)
  invitedEmail    String?
  status          PartnerStatus @default(PENDING)
  commissionPct   Decimal       @default(10) @db.Decimal(5, 2)
  canImpersonate  Boolean       @default(true)
  inviteToken     String?       @unique
  inviteExpiresAt DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([partnerOrgId, clientOrgId])
  @@index([partnerOrgId])
  @@index([clientOrgId])
  @@index([partnerOrgId, invitedEmail])
}

model CommissionLedger {
  id           String         @id @default(cuid())
  partnerOrgId String
  partnerOrg   Organization   @relation("LedgerPartnerOrg", fields: [partnerOrgId], references: [id], onDelete: Cascade)
  clientOrgId  String
  clientOrg    Organization   @relation("LedgerClientOrg", fields: [clientOrgId], references: [id], onDelete: Cascade)
  type         CommissionType
  amount       Decimal        @db.Decimal(10, 2)
  currency     String         @default("TRY")
  description  String?
  referenceId  String?
  status       LedgerStatus   @default(PENDING)
  createdAt    DateTime       @default(now())
  settledAt    DateTime?

  @@index([partnerOrgId])
  @@index([clientOrgId])
}

model AuditLog {
  id                String   @id @default(cuid())
  actorUserId       String
  actorOrgId        String
  impersonatedOrgId String?
  action            String
  resourceType      String
  resourceId        String?
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Fiyatlandırma kuralları (Pro+)
model PricingRule {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  platform       Marketplace
  strategy       PricingStrategy
  minMarginPct   Decimal         @default(10) @db.Decimal(5, 2)
  maxDiscountPct Decimal         @default(20) @db.Decimal(5, 2)
  targetPosition Int             @default(1)
  /// Maliyet fiyatı (kâr hesaplama için, TRY)
  costPrice                Float?
  /// Minimum kâr marjı oranı (0.10 = %10); yoksa minMarginPct kullanılır
  minMarginPercent         Float?
  /// Rakip / BuyBox fiyatından düşülecek adım (TRY)
  stepAmount               Float?
  /// Gece (00–06) indirim oranı (0.05 = %5)
  nightDiscountPercent     Float?
  /// Öğle peak premium (0.03 = %3)
  peakPremiumPercent       Float?
  /// Düşük stok eşiği (adet)
  lowStockThreshold        Int?
  /// Yüksek stok eşiği (adet)
  highStockThreshold       Int?
  /// Tavan fiyat (TRY)
  maxPrice                 Float?
  isActive       Boolean         @default(true)
  applyToAll     Boolean         @default(false)
  barcodes       String[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  priceHistories PriceHistory[]

  @@index([organizationId])
  @@index([organizationId, platform])
}

// Fiyat değişim geçmişi
model PriceHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  barcode        String
  platform       Marketplace
  pricingRuleId  String?
  pricingRule    PricingRule? @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)
  oldPrice       Decimal      @db.Decimal(10, 2)
  newPrice       Decimal      @db.Decimal(10, 2)
  reason         String?
  appliedAt      DateTime     @default(now())

  @@index([organizationId, barcode])
  @@index([organizationId, platform])
}

// BuyBox anlık veri (rakip fiyat takibi)
model BuyBoxSnapshot {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  barcode         String
  platform        Marketplace
  buyBoxPrice     Decimal      @db.Decimal(10, 2)
  ourPrice        Decimal      @db.Decimal(10, 2)
  isWinner        Boolean      @default(false)
  competitorCount Int          @default(0)
  capturedAt      DateTime     @default(now())

  @@index([organizationId, barcode, platform])
  @@index([organizationId, platform, capturedAt])
}
