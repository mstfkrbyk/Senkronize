  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum PartnerLinkStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommissionType {
  SUBSCRIPTION_FEE
  SERVICE_FEE
  BONUS
  DEDUCTION
}

enum LedgerStatus {
  PENDING
  SETTLED
  CANCELLED
}

enum SyncDirection {
  PUSH
  PULL
}

