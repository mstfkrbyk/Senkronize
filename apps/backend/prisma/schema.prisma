// Senkronize — multi-tenant veri modeli (Bölüm 7 + tamamlayıcı ilişkiler)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

